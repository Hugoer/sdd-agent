generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  DONE
  IGNORED
  FAILED

  @@map("webhook_event_status")
}

/// One row per GitHub webhook delivery (deduplicated by delivery ID).
model WebhookEvent {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId   String             @unique @map("delivery_id")
  eventName    String             @map("event_name")
  action       String?
  payload      Json               @db.JsonB
  status       WebhookEventStatus @default(PENDING)
  ignoreReason String?            @map("ignore_reason")
  attempts     Int                @default(0)
  availableAt  DateTime           @default(now()) @map("available_at") @db.Timestamptz
  lastError    String?            @map("last_error")
  receivedAt   DateTime           @default(now()) @map("received_at") @db.Timestamptz
  processedAt  DateTime?          @map("processed_at") @db.Timestamptz
  /// The issue or PR the event is about, `owner/repo#number` (spec 2, IA14); null when the payload has none.
  externalRef  String?            @map("external_ref")

  @@index([status, availableAt, receivedAt])
  @@index([externalRef, receivedAt])
  @@map("webhook_events")
}

/// One row per model call attempt (spec 4, L11): a re-ask is a new row, a worker retry makes new rows. Only
/// inserted by ExecutionLogService; never updated or deleted by the app. Token columns: empty = not reported.
model ExecutionLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// When the request ended (spec 11: one row per model request; was per attempt).
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  platform          String
  taskId            String   @map("task_id")
  externalRef       String   @map("external_ref")
  /// The run (spec 5 defines it); `smoke-<id>` for the smoke script.
  runId             String?  @map("run_id")
  lane              String?
  step              String
  provider          String
  /// The model name sent.
  model             String
  modelLevel        String   @map("model_level")
  /// The base-branch commit the skill and the map were read at.
  skillCommit       String   @map("skill_commit")
  /// 1 = a load turn or a first answer, 2 and 3 = re-asks (spec 11, SDW13).
  attempt           Int
  /// Spec 11: the `LlmService.call()` the row belongs to; empty on rows written before spec 11.
  callId            String?  @map("call_id") @db.Uuid
  /// Spec 11 (SDW13): 1, 2, … within the call; rows written before spec 11 have `turn = attempt`.
  turn              Int      @default(1)
  /// `SUCCESS` or `ERROR`.
  status            String
  errorCode         String?  @map("error_code")
  /// At most 2,000 characters.
  errorMessage      String?  @map("error_message")
  /// The model call only.
  durationMs        Int      @map("duration_ms")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  cachedInputTokens Int?     @map("cached_input_tokens")
  reasoningTokens   Int?     @map("reasoning_tokens")
  /// The step's frame, the fixed paragraphs and (spec 11) the "Loading:" paragraph.
  frameChars        Int      @map("frame_chars")
  /// The step skill block, with its "Other files" list (spec 11).
  skillChars        Int      @map("skill_chars")
  untrustedChars    Int      @map("untrusted_chars")
  /// Everything else in the turns; spec 11: also the model's earlier messages with their tool calls.
  otherChars        Int      @map("other_chars")
  /// Spec 11 (SDW9): the root AGENTS.md section.
  agentsChars       Int      @default(0) @map("agents_chars")
  /// Spec 11 (SDW9): the skills list and the AGENTS.md list.
  listsChars        Int      @default(0) @map("lists_chars")
  /// Spec 11 (SDW9): the tool messages (loaded files and one-line answers).
  loadedChars       Int      @default(0) @map("loaded_chars")
  answerChars       Int?     @map("answer_chars")
  /// Kinds matched in this call's untrusted texts; empty = none.
  injectionKinds    String[] @map("injection_kinds")
  /// Spec 12 (BDW11): the kinds of the `[REDACTED: <kind>]` placeholders in this request's untrusted texts, each
  /// once, `own-secret` included; empty = none.
  secretKinds       String[] @default([]) @map("secret_kinds")
  /// Source keys of the untrusted texts that were cut.
  cutSources        String[] @map("cut_sources")
  /// The messages as sent (LangChain StoredMessage[], after wrapping and cutting). Spec 11 (L18): turn 1 holds the
  /// whole prompt; a later turn only the messages added since the previous row.
  prompt            Json     @db.JsonB
  /// The answer as received, before the schema check; empty when the call itself failed.
  answer            Json?    @db.JsonB
  /// LangChain's usage_metadata, as received.
  providerUsage     Json?    @map("provider_usage") @db.JsonB
  /// LangChain's response_metadata, as received.
  providerMeta      Json?    @map("provider_meta") @db.JsonB

  @@index([platform, taskId, createdAt])
  @@index([step, model])
  @@index([callId, turn])
  @@map("execution_logs")
}

/// Spec 11 ("Owned table: ContextLoad"): one row per file the model got or asked for. Written only by
/// ContextLoadService; a row is inserted when the file is given or asked for, and only its two token columns are
/// set later in the same call.
model ContextLoad {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// When the file was given or asked for.
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  platform        String
  taskId          String   @map("task_id")
  externalRef     String   @map("external_ref")
  /// As `execution_logs.run_id` (`smoke-<id>` for the smoke script).
  runId           String?  @map("run_id")
  step            String
  /// The call; joins `execution_logs.call_id`.
  callId          String   @map("call_id") @db.Uuid
  /// The request whose answer asked for it; 0 = given at start.
  turn            Int
  /// `start` or `tool`.
  trigger         String
  /// `load_skill` or `load_file`; empty for `start`.
  tool            String?
  /// The name or path as the model wrote it (cut at 300 characters).
  requested       String?
  /// The model's reason (cut at 300); `(none given)` when missing; empty for `start`.
  reason          String?
  /// `step-skill`, `repo-skill`, `agents`; empty when nothing matched.
  kind            String?
  /// The step name (`step-skill`) or the repo skill's name.
  skill           String?
  /// The file's repo path; empty when nothing matched.
  path            String?
  /// The call's base-branch commit.
  commit          String
  /// The call's model (the key of the token count).
  model           String
  /// `loaded`, `already-loaded`, `not-found`, `too-large`, `unreadable`, `limit-reached`, `error` (plan P21).
  outcome         String
  /// From the listing, when the file is known.
  bytes           Int?
  /// The file's own text, in characters (what `tokens` counts, plan P16); only for `loaded`.
  chars           Int?
  /// The provider's count (SD5); empty = no count.
  tokens          Int?
  /// The bot's estimate (SD5); empty = no input tokens reported.
  estimatedTokens Int?     @map("estimated_tokens")
  /// Kinds matched in the file (SDW8); empty = none.
  injectionKinds  String[] @map("injection_kinds")

  @@index([callId])
  @@index([platform, taskId, createdAt])
  @@index([path, commit, model])
  @@map("context_loads")
}

/// One row per issue (spec 5, "Owned tables"). `status` is the source of truth; `shownStatus` is the `status: *`
/// label GitHub shows (null = none set). Only TaskService writes it; every write inside a job checks the lease.
model Task {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `TaskRef.platform`.
  platform          String
  /// `TaskRef.id`.
  platformId        String           @map("platform_id")
  /// `owner/repo#number`, refreshed from every event.
  externalRef       String           @map("external_ref")
  /// A `TaskStatus`.
  status            String           @default("draft")
  shownStatus       String?          @map("shown_status")
  /// Null when no run is current.
  currentRunId      String?          @unique @map("current_run_id") @db.Uuid
  currentRun        Run?             @relation("CurrentRun", fields: [currentRunId], references: [id])
  /// The last run number.
  runCount          Int              @default(0) @map("run_count")
  /// The `webhook_events.id` holding the session lease.
  leaseOwner        String?          @map("lease_owner") @db.Uuid
  leaseExpiresAt    DateTime?        @map("lease_expires_at") @db.Timestamptz
  /// RL8, plan Q3: the lanes the open lane-conflict reminder lists; empty when none is open.
  laneConflictLanes String[]         @default([]) @map("lane_conflict_lanes")
  /// Reminders posted so far (their marker's number).
  laneConflicts     Int              @default(0) @map("lane_conflicts")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  runs              Run[]            @relation("TaskRuns")
  grillSessions     GrillSession[]
  documents         TaskDocument[]
  documentActions   DocumentAction[]

  @@unique([platform, platformId])
  @@map("tasks")
}

/// One row per run (spec 5, D24): its id is the run id everywhere (`execution_logs.run_id`, specs 6–10). A stop
/// (`needs-human`) pauses a run; only a cancel or a restart ends it (RLW1). Only RunService writes it.
model Run {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId               String           @map("task_id") @db.Uuid
  task                 Task             @relation("TaskRuns", fields: [taskId], references: [id])
  /// 1, 2, 3 … per task.
  number               Int
  lane                 String
  /// `grill: skip`, read at run start.
  grillSkip            Boolean          @map("grill_skip")
  /// The `webhook_events` row that started it.
  startEventId         String           @map("start_event_id") @db.Uuid
  /// A copy of that event's `received_at`, for the stale rule (RL10).
  startEventReceivedAt DateTime         @map("start_event_received_at") @db.Timestamptz
  startedAt            DateTime         @default(now()) @map("started_at") @db.Timestamptz
  endedAt              DateTime?        @map("ended_at") @db.Timestamptz
  /// `cancelled` or `restarted`.
  endReason            String?          @map("end_reason")
  /// The `webhook_events` row that ended it; its sender is named in the run-ended comment (plan Q2).
  endEventId           String?          @map("end_event_id") @db.Uuid
  /// Set while stopped (`needs-human`); cleared by `/retry`.
  stoppedAt            DateTime?        @map("stopped_at") @db.Timestamptz
  /// The latest stop, kept after `/retry` and after the run ends.
  stopStep             String?          @map("stop_step")
  stopCause            String?          @map("stop_cause")
  stopMessage          String?          @map("stop_message")
  stopRetryable        Boolean?         @map("stop_retryable")
  /// The event `/retry` re-queues.
  stopEventId          String?          @map("stop_event_id") @db.Uuid
  /// The status `/retry` restores.
  statusBeforeStop     String?          @map("status_before_stop")
  /// Null while the stop comment is pending (RL5).
  stopCommentId        String?          @map("stop_comment_id")
  /// The run-ended comment; null on an ended run while it is pending (RL5, plan Q1).
  endCommentId         String?          @map("end_comment_id")
  stops                Int              @default(0)
  retries              Int              @default(0)
  currentFor           Task?            @relation("CurrentRun")
  grillSession         GrillSession?
  documents            TaskDocument[]
  documentActions      DocumentAction[]

  @@unique([taskId, number])
  @@index([taskId, startedAt])
  @@map("runs")
}

/// One per run that grills or skips (spec 6, "Owned tables"). Only GrillStore writes the four Grill tables, and
/// every transaction first checks the session lease (spec 5). Statuses are text, like `tasks.status`.
model GrillSession {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String            @map("task_id") @db.Uuid
  task             Task              @relation(fields: [taskId], references: [id])
  /// One session per run (spec 5 agreement).
  runId            String            @unique @map("run_id") @db.Uuid
  run              Run               @relation(fields: [runId], references: [id])
  /// `ASKING`, `CLEAR`, `LIMIT`, `SKIPPED` (at run start), `STOPPED` (`grill: skip` while asking), `CANCELLED`
  /// (the run ended while asking).
  status           String
  /// Question comments posted (Tx1 counts it).
  rounds           Int               @default(0)
  /// The last question number used (GM5).
  lastQuestion     Int               @default(0) @map("last_question")
  /// From the first and the latest acting evaluation; null when skipped.
  firstConfidence  Int?              @map("first_confidence")
  lastConfidence   Int?              @map("last_confidence")
  /// The login that added `grill: skip` while asking.
  stoppedBy        String?           @map("stopped_by")
  startedAt        DateTime          @default(now()) @map("started_at") @db.Timestamptz
  /// Set with the final status.
  endedAt          DateTime?         @map("ended_at") @db.Timestamptz
  grillEvaluations GrillEvaluation[]
  grillRounds      GrillRound[]
  grillAnswers     GrillAnswer[]

  @@index([taskId, startedAt])
  @@map("grill_sessions")
}

/// One per model evaluation that returned a valid answer (spec 6).
model GrillEvaluation {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String        @map("session_id") @db.Uuid
  session           GrillSession  @relation(fields: [sessionId], references: [id])
  /// `ExecutionLog` id of the call's last attempt (L16; no foreign key, like `execution_logs.run_id`).
  logId             String        @map("log_id") @db.Uuid
  /// As in `LlmResult.model` (usage data; the comments' model line is in `notes`).
  model             String
  modelLevel        String        @map("model_level")
  /// Question comments posted when it ran (0 = before the first).
  afterRound        Int           @map("after_round")
  /// `ASKED`, `CLEAR`, `LIMIT`, `WAITING`, `SUPERSEDED`.
  result            String
  confidence        Int
  /// How many the model returned, before the cap K.
  questionsProposed Int           @map("questions_proposed")
  /// The model's open numbers.
  open              Int[]
  gaps              String[]
  /// The lines under the comment's rule (`LlmResult.notes`), so a retried post is the same (plan P2).
  notes             String[]
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  grillRound        GrillRound?
  grillAnswers      GrillAnswer[]

  @@index([sessionId, createdAt])
  @@map("grill_evaluations")
}

/// One per question comment (spec 6): stored with its full text in Tx1, marked posted in Tx2.
model GrillRound {
  /// In the comment's marker.
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String          @map("session_id") @db.Uuid
  session      GrillSession    @relation(fields: [sessionId], references: [id])
  /// 1, 2, … per session.
  number       Int
  /// The evaluation that asked.
  evaluationId String          @unique @map("evaluation_id") @db.Uuid
  evaluation   GrillEvaluation @relation(fields: [evaluationId], references: [id])
  /// That evaluation's call (L16).
  logId        String          @map("log_id") @db.Uuid
  /// `[{ number, question, guess }]` as posted (model text cleaned, GMW3).
  questions    Json            @db.JsonB
  /// Earlier numbers shown as "Still open".
  stillOpen    Int[]           @map("still_open")
  /// The comment's full text with its marker, posted as is (recovery).
  body         String
  /// `PENDING_POST` or `POSTED`.
  postState    String          @map("post_state")
  commentId    String?         @map("comment_id")
  commentUrl   String?         @map("comment_url")
  /// The comment's creation time on GitHub.
  postedAt     DateTime?       @map("posted_at") @db.Timestamptz
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@unique([sessionId, number])
  @@map("grill_rounds")
}

/// One per comment read as an answer (spec 6): a comment is read once per session.
model GrillAnswer {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  session      GrillSession     @relation(fields: [sessionId], references: [id])
  /// The evaluation that read it; null when read by the skip op.
  evaluationId String?          @map("evaluation_id") @db.Uuid
  evaluation   GrillEvaluation? @relation(fields: [evaluationId], references: [id])
  /// The round open when it was read (0 = before the first question).
  afterRound   Int              @map("after_round")
  commentId    String           @map("comment_id")
  /// The author's login.
  author       String
  /// As written (raw; wrapped per call).
  body         String
  url          String?
  /// The comment's creation time on GitHub.
  createdAt    DateTime         @map("created_at") @db.Timestamptz
  readAt       DateTime         @default(now()) @map("read_at") @db.Timestamptz
  /// 👀 added.
  acknowledged Boolean          @default(false)

  @@unique([sessionId, commentId])
  @@map("grill_answers")
}

/// One per posted version of a Spec or a Plan, and one per go-signal (spec 7, "Owned tables"). Only DocumentsStore
/// writes the two document tables, and every transaction first checks the session lease (spec 5). Stored with its
/// full comment in Tx1, marked posted in Tx2.
model TaskDocument {
  /// In the comment's marker.
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId             String           @map("task_id") @db.Uuid
  task               Task             @relation(fields: [taskId], references: [id])
  runId              String           @map("run_id") @db.Uuid
  run                Run              @relation(fields: [runId], references: [id])
  /// `spec`, `plan`, `go-signal`.
  kind               String
  /// 1, 2, … per run and kind; a restore keeps it (SPW18); 1 for the go-signal.
  version            Int
  /// `written`, `refreshed`, `restored`.
  origin             String
  /// The version a refresh or a restore started from; a Plan `written`: the approved Spec version.
  basedOnId          String?          @map("based_on_id") @db.Uuid
  basedOn            TaskDocument?    @relation("BasedOn", fields: [basedOnId], references: [id])
  basedOnBy          TaskDocument[]   @relation("BasedOn")
  /// The base-branch commit its model read (a restore: the original's); null for the go-signal.
  commit             String?
  /// The latest commit a refresh found it up to date at (SPW11).
  checkedCommit      String?          @map("checked_commit")
  /// Spec 14 (UAW3): the commit the version's last question compared to; cleared when a refresh moves
  /// `checkedCommit`; only `/approve` reads it.
  askedCommit        String?          @map("asked_commit")
  /// The call's last `execution_logs` row (L16; no foreign key); null for a restore and the go-signal.
  logId              String?          @map("log_id") @db.Uuid
  /// The document as posted (cleaned, `redact()`ed); a restore: the text it restored; empty for the go-signal.
  text               String
  /// A refresh's "What changed" lines.
  changes            String[]
  /// The lines under the comment's rule, so a restore repeats them (plan P12).
  notes              String[]
  /// The `/refresh` or `/restore` that made it (a retried event finds it).
  triggerCommentId   String?          @map("trigger_comment_id")
  /// The comment's full text with its marker, posted as is (recovery).
  body               String
  /// `PENDING_POST` or `POSTED`.
  postState          String           @map("post_state")
  commentId          String?          @map("comment_id")
  commentUrl         String?          @map("comment_url")
  /// The comment's creation time on GitHub (the `/approve` time check).
  postedAt           DateTime?        @map("posted_at") @db.Timestamptz
  /// A newer version replaced it, or (a Plan) its Spec was refreshed.
  supersededAt       DateTime?        @map("superseded_at") @db.Timestamptz
  /// From the deletion event, or when a command found the comment gone.
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz
  deletedBy          String?          @map("deleted_by")
  /// Its document text when deleted (`redact()`ed); null when the bot missed the event.
  deletedText        String?          @map("deleted_text")
  /// The text at `/approve` (`redact()`ed); the go-signal: the issue's title and description.
  approvedText       String?          @map("approved_text")
  approvedBy         String?          @map("approved_by")
  approvedAt         DateTime?        @map("approved_at") @db.Timestamptz
  /// The event and the comment that approved it (a retried event is recognized).
  approveEventId     String?          @map("approve_event_id") @db.Uuid
  approveCommentId   String?          @map("approve_comment_id")
  /// The base-branch commit at the approval.
  approvedCommit     String?          @map("approved_commit")
  /// Spec 14: the start of the range the approval compared and stored (`checkedCommit ?? commit` then); null for the
  /// go-signal and for approvals stored before spec 14.
  approvedFromCommit String?          @map("approved_from_commit")
  /// Changed since `checkedCommit` or `commit` and read by its calls (SP3).
  staleFiles         String[]         @map("stale_files")
  /// How many changed in all; null when not compared (same commit).
  changedFiles       Int?             @map("changed_files")
  /// Every changed path at the approval, up to GitHub's 300 (plan P33).
  changedPaths       String[]         @map("changed_paths")
  /// False when the host cut the list; null when the comparison failed.
  changedComplete    Boolean?         @map("changed_complete")
  /// Posted text → approved text (SPW14).
  linesAdded         Int?             @map("lines_added")
  linesRemoved       Int?             @map("lines_removed")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  actions            DocumentAction[]

  @@unique([runId, kind, triggerCommentId])
  @@index([runId, kind, version])
  @@index([commentId])
  @@map("task_documents")
}

/// One per human action spec 7 answered with a reply, or that made a version (`refresh`, `restore`).
model DocumentAction {
  /// In the reply's marker.
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String        @map("task_id") @db.Uuid
  task            Task          @relation(fields: [taskId], references: [id])
  /// Null when the issue has no run (plan P7).
  runId           String?       @map("run_id") @db.Uuid
  run             Run?          @relation(fields: [runId], references: [id])
  /// The document concerned, or the version a refresh or a restore made.
  documentId      String?       @map("document_id") @db.Uuid
  document        TaskDocument? @relation(fields: [documentId], references: [id])
  /// `approve-refused`, `approve-hint`, `approve-asked` (spec 14), `late-comment`, `refresh`, `refresh-refused`,
  /// `deleted`, `restore`, `restore-refused`; `approve-warning` (spec 7, no longer written).
  action          String
  /// Per action, as the spec's table.
  result          String
  /// The webhook event (no foreign key).
  eventId         String        @map("event_id") @db.Uuid
  /// The human comment answered, or the deleted comment.
  sourceCommentId String        @map("source_comment_id")
  sender          String
  /// A refresh's calls (one or two).
  logIds          String[]      @map("log_ids") @db.Uuid
  /// The reply with its marker, stored in Tx1; null when the answer is a version.
  replyBody       String?       @map("reply_body")
  /// `PENDING_POST` or `POSTED`; null without a reply.
  replyPostState  String?       @map("reply_post_state")
  replyCommentId  String?       @map("reply_comment_id")
  /// Spec 14 (UAW9, plan UP2): the reply's URL and creation time on GitHub, recorded with `replyCommentId`.
  replyCommentUrl String?       @map("reply_comment_url")
  replyPostedAt   DateTime?     @map("reply_posted_at") @db.Timestamptz
  /// Spec 14, `approve-asked`: the starting point and the commit now.
  fromCommit      String?       @map("from_commit")
  toCommit        String?       @map("to_commit")
  /// Spec 14, `approve-asked`: every flagged file, `[{ path, readers: ['own' | 'spec'] }]`; empty when none.
  files           Json?
  /// Spec 14, `approve-asked`: how many paths changed in the range; null when not compared.
  changedFiles    Int?          @map("changed_files")
  /// Spec 14, `approve-asked`: false when GitHub cut the list; null when not compared.
  filesComplete   Boolean?      @map("files_complete")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([action, sourceCommentId])
  @@index([runId, createdAt])
  @@map("document_actions")
}
