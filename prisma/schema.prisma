generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  DONE
  IGNORED
  FAILED

  @@map("webhook_event_status")
}

/// One row per GitHub webhook delivery (deduplicated by delivery ID).
model WebhookEvent {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId   String             @unique @map("delivery_id")
  eventName    String             @map("event_name")
  action       String?
  payload      Json               @db.JsonB
  status       WebhookEventStatus @default(PENDING)
  ignoreReason String?            @map("ignore_reason")
  attempts     Int                @default(0)
  availableAt  DateTime           @default(now()) @map("available_at") @db.Timestamptz
  lastError    String?            @map("last_error")
  receivedAt   DateTime           @default(now()) @map("received_at") @db.Timestamptz
  processedAt  DateTime?          @map("processed_at") @db.Timestamptz
  /// The issue or PR the event is about, `owner/repo#number` (spec 2, IA14); null when the payload has none.
  externalRef  String?            @map("external_ref")

  @@index([status, availableAt, receivedAt])
  @@index([externalRef, receivedAt])
  @@map("webhook_events")
}

/// One row per model call attempt (spec 4, L11): a re-ask is a new row, a worker retry makes new rows. Only
/// inserted by ExecutionLogService; never updated or deleted by the app. Token columns: empty = not reported.
model ExecutionLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// When the attempt ended.
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  platform          String
  taskId            String   @map("task_id")
  externalRef       String   @map("external_ref")
  /// The run (spec 5 defines it); `smoke-<id>` for the smoke script.
  runId             String?  @map("run_id")
  lane              String?
  step              String
  provider          String
  /// The model name sent.
  model             String
  modelLevel        String   @map("model_level")
  /// The base-branch commit the skill and the map were read at.
  skillCommit       String   @map("skill_commit")
  /// 1 = first ask, 2 and 3 = re-asks.
  attempt           Int
  /// `SUCCESS` or `ERROR`.
  status            String
  errorCode         String?  @map("error_code")
  /// At most 2,000 characters.
  errorMessage      String?  @map("error_message")
  /// The model call only.
  durationMs        Int      @map("duration_ms")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  cachedInputTokens Int?     @map("cached_input_tokens")
  reasoningTokens   Int?     @map("reasoning_tokens")
  frameChars        Int      @map("frame_chars")
  skillChars        Int      @map("skill_chars")
  untrustedChars    Int      @map("untrusted_chars")
  otherChars        Int      @map("other_chars")
  answerChars       Int?     @map("answer_chars")
  /// Kinds matched in this call's untrusted texts; empty = none.
  injectionKinds    String[] @map("injection_kinds")
  /// Source keys of the untrusted texts that were cut.
  cutSources        String[] @map("cut_sources")
  /// The messages as sent (LangChain StoredMessage[], after wrapping and cutting).
  prompt            Json     @db.JsonB
  /// The answer as received, before the schema check; empty when the call itself failed.
  answer            Json?    @db.JsonB
  /// LangChain's usage_metadata, as received.
  providerUsage     Json?    @map("provider_usage") @db.JsonB
  /// LangChain's response_metadata, as received.
  providerMeta      Json?    @map("provider_meta") @db.JsonB

  @@index([platform, taskId, createdAt])
  @@index([step, model])
  @@map("execution_logs")
}

/// One row per issue (spec 5, "Owned tables"). `status` is the source of truth; `shownStatus` is the `status: *`
/// label GitHub shows (null = none set). Only TaskService writes it; every write inside a job checks the lease.
model Task {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `TaskRef.platform`.
  platform          String
  /// `TaskRef.id`.
  platformId        String         @map("platform_id")
  /// `owner/repo#number`, refreshed from every event.
  externalRef       String         @map("external_ref")
  /// A `TaskStatus`.
  status            String         @default("draft")
  shownStatus       String?        @map("shown_status")
  /// Null when no run is current.
  currentRunId      String?        @unique @map("current_run_id") @db.Uuid
  currentRun        Run?           @relation("CurrentRun", fields: [currentRunId], references: [id])
  /// The last run number.
  runCount          Int            @default(0) @map("run_count")
  /// The `webhook_events.id` holding the session lease.
  leaseOwner        String?        @map("lease_owner") @db.Uuid
  leaseExpiresAt    DateTime?      @map("lease_expires_at") @db.Timestamptz
  /// RL8, plan Q3: the lanes the open lane-conflict reminder lists; empty when none is open.
  laneConflictLanes String[]       @default([]) @map("lane_conflict_lanes")
  /// Reminders posted so far (their marker's number).
  laneConflicts     Int            @default(0) @map("lane_conflicts")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  runs              Run[]          @relation("TaskRuns")
  grillSessions     GrillSession[]

  @@unique([platform, platformId])
  @@map("tasks")
}

/// One row per run (spec 5, D24): its id is the run id everywhere (`execution_logs.run_id`, specs 6–10). A stop
/// (`needs-human`) pauses a run; only a cancel or a restart ends it (RLW1). Only RunService writes it.
model Run {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId               String        @map("task_id") @db.Uuid
  task                 Task          @relation("TaskRuns", fields: [taskId], references: [id])
  /// 1, 2, 3 … per task.
  number               Int
  lane                 String
  /// `grill: skip`, read at run start.
  grillSkip            Boolean       @map("grill_skip")
  /// The `webhook_events` row that started it.
  startEventId         String        @map("start_event_id") @db.Uuid
  /// A copy of that event's `received_at`, for the stale rule (RL10).
  startEventReceivedAt DateTime      @map("start_event_received_at") @db.Timestamptz
  startedAt            DateTime      @default(now()) @map("started_at") @db.Timestamptz
  endedAt              DateTime?     @map("ended_at") @db.Timestamptz
  /// `cancelled` or `restarted`.
  endReason            String?       @map("end_reason")
  /// The `webhook_events` row that ended it; its sender is named in the run-ended comment (plan Q2).
  endEventId           String?       @map("end_event_id") @db.Uuid
  /// Set while stopped (`needs-human`); cleared by `/retry`.
  stoppedAt            DateTime?     @map("stopped_at") @db.Timestamptz
  /// The latest stop, kept after `/retry` and after the run ends.
  stopStep             String?       @map("stop_step")
  stopCause            String?       @map("stop_cause")
  stopMessage          String?       @map("stop_message")
  stopRetryable        Boolean?      @map("stop_retryable")
  /// The event `/retry` re-queues.
  stopEventId          String?       @map("stop_event_id") @db.Uuid
  /// The status `/retry` restores.
  statusBeforeStop     String?       @map("status_before_stop")
  /// Null while the stop comment is pending (RL5).
  stopCommentId        String?       @map("stop_comment_id")
  /// The run-ended comment; null on an ended run while it is pending (RL5, plan Q1).
  endCommentId         String?       @map("end_comment_id")
  stops                Int           @default(0)
  retries              Int           @default(0)
  currentFor           Task?         @relation("CurrentRun")
  grillSession         GrillSession?

  @@unique([taskId, number])
  @@index([taskId, startedAt])
  @@map("runs")
}

/// One per run that grills or skips (spec 6, "Owned tables"). Only GrillStore writes the four Grill tables, and
/// every transaction first checks the session lease (spec 5). Statuses are text, like `tasks.status`.
model GrillSession {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String            @map("task_id") @db.Uuid
  task             Task              @relation(fields: [taskId], references: [id])
  /// One session per run (spec 5 agreement).
  runId            String            @unique @map("run_id") @db.Uuid
  run              Run               @relation(fields: [runId], references: [id])
  /// `ASKING`, `CLEAR`, `LIMIT`, `SKIPPED` (at run start), `STOPPED` (`grill: skip` while asking), `CANCELLED`
  /// (the run ended while asking).
  status           String
  /// Question comments posted (Tx1 counts it).
  rounds           Int               @default(0)
  /// The last question number used (GM5).
  lastQuestion     Int               @default(0) @map("last_question")
  /// From the first and the latest acting evaluation; null when skipped.
  firstConfidence  Int?              @map("first_confidence")
  lastConfidence   Int?              @map("last_confidence")
  /// The login that added `grill: skip` while asking.
  stoppedBy        String?           @map("stopped_by")
  startedAt        DateTime          @default(now()) @map("started_at") @db.Timestamptz
  /// Set with the final status.
  endedAt          DateTime?         @map("ended_at") @db.Timestamptz
  grillEvaluations GrillEvaluation[]
  grillRounds      GrillRound[]
  grillAnswers     GrillAnswer[]

  @@index([taskId, startedAt])
  @@map("grill_sessions")
}

/// One per model evaluation that returned a valid answer (spec 6).
model GrillEvaluation {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String        @map("session_id") @db.Uuid
  session           GrillSession  @relation(fields: [sessionId], references: [id])
  /// `ExecutionLog` id of the call's last attempt (L16; no foreign key, like `execution_logs.run_id`).
  logId             String        @map("log_id") @db.Uuid
  /// As in `LlmResult.model` (usage data; the comments' model line is in `notes`).
  model             String
  modelLevel        String        @map("model_level")
  /// Question comments posted when it ran (0 = before the first).
  afterRound        Int           @map("after_round")
  /// `ASKED`, `CLEAR`, `LIMIT`, `WAITING`, `SUPERSEDED`.
  result            String
  confidence        Int
  /// How many the model returned, before the cap K.
  questionsProposed Int           @map("questions_proposed")
  /// The model's open numbers.
  open              Int[]
  gaps              String[]
  /// The lines under the comment's rule (`LlmResult.notes`), so a retried post is the same (plan P2).
  notes             String[]
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  grillRound        GrillRound?
  grillAnswers      GrillAnswer[]

  @@index([sessionId, createdAt])
  @@map("grill_evaluations")
}

/// One per question comment (spec 6): stored with its full text in Tx1, marked posted in Tx2.
model GrillRound {
  /// In the comment's marker.
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String          @map("session_id") @db.Uuid
  session      GrillSession    @relation(fields: [sessionId], references: [id])
  /// 1, 2, … per session.
  number       Int
  /// The evaluation that asked.
  evaluationId String          @unique @map("evaluation_id") @db.Uuid
  evaluation   GrillEvaluation @relation(fields: [evaluationId], references: [id])
  /// That evaluation's call (L16).
  logId        String          @map("log_id") @db.Uuid
  /// `[{ number, question, guess }]` as posted (model text cleaned, GMW3).
  questions    Json            @db.JsonB
  /// Earlier numbers shown as "Still open".
  stillOpen    Int[]           @map("still_open")
  /// The comment's full text with its marker, posted as is (recovery).
  body         String
  /// `PENDING_POST` or `POSTED`.
  postState    String          @map("post_state")
  commentId    String?         @map("comment_id")
  commentUrl   String?         @map("comment_url")
  /// The comment's creation time on GitHub.
  postedAt     DateTime?       @map("posted_at") @db.Timestamptz
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@unique([sessionId, number])
  @@map("grill_rounds")
}

/// One per comment read as an answer (spec 6): a comment is read once per session.
model GrillAnswer {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  session      GrillSession     @relation(fields: [sessionId], references: [id])
  /// The evaluation that read it; null when read by the skip op.
  evaluationId String?          @map("evaluation_id") @db.Uuid
  evaluation   GrillEvaluation? @relation(fields: [evaluationId], references: [id])
  /// The round open when it was read (0 = before the first question).
  afterRound   Int              @map("after_round")
  commentId    String           @map("comment_id")
  /// The author's login.
  author       String
  /// As written (raw; wrapped per call).
  body         String
  url          String?
  /// The comment's creation time on GitHub.
  createdAt    DateTime         @map("created_at") @db.Timestamptz
  readAt       DateTime         @default(now()) @map("read_at") @db.Timestamptz
  /// 👀 added.
  acknowledged Boolean          @default(false)

  @@unique([sessionId, commentId])
  @@map("grill_answers")
}
