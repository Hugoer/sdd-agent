{
  "name": "sdd-agent",
  "version": "0.1.0",
  "description": "GitHub AI agent: moves issues through Grill Me → Spec → Plan → Coder → Quality Gate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:reset": "prisma migrate reset",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "db:migrate": "prisma migrate dev",
    "db:events": "docker compose exec -T postgres psql -U sdd_agent -d sdd_agent -c \"SELECT delivery_id, event_name, action, external_ref, payload->'sender'->>'login' AS sender, status, ignore_reason, attempts, left(last_error, 80) AS last_error, received_at FROM webhook_events ORDER BY received_at DESC LIMIT 20\"",
    "postinstall": "prisma generate",
    "tunnel": "node --env-file-if-exists=.env scripts/tunnel.mjs",
    "github:smoke": "nest build && node dist/github/smoke/github-smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
