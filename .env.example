# Copy to .env and fill in. Never commit .env or the private key.
PORT=3000
DATABASE_URL=postgresql://sdd_agent:sdd_agent@localhost:5432/sdd_agent
GITHUB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/Users/you/.config/sdd-agent/github-app.pem
# The repo the bot works on (owner/name); the App must be installed there.
TARGET_REPO=you/sdd-agent-sandbox
NGROK_DOMAIN=your-name.ngrok-free.app
# Google AI Studio key for Gemini (spec 4). Never set a LangChain tracing switch
# (LANGSMITH_TRACING, LANGCHAIN_TRACING, their _V2 forms): the app refuses to start.
GOOGLE_API_KEY=replace-with-your-google-ai-studio-key
# The target repo's branch the bot reads workflow.json and the skills from.
TARGET_BASE_BRANCH=main